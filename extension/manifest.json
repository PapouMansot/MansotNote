{
  "manifest_version": 3,
  "name": "MansotNote Web Clipper",
  "version": "1.1.1",
  "description": "Capturez des pages web, textes sélectionnés et articles directement dans MansotNote (Notes Markdown & Kanban).",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://notes.mansotfamily.fr/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MansotNote Web Clipper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
